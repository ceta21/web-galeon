# Clave de Groq para el asistente "Nova" (gratis, sin tarjeta: https://console.groq.com/keys).
# Copia este archivo a .env.local y pon tu clave. Nunca se envía al navegador.
GROQ_API_KEY=

# Envío del formulario de contacto con Resend (gratis hasta 3.000 emails/mes: https://resend.com/api-keys).
# Sin clave, los mensajes solo quedan en el registro del servidor.
RESEND_API_KEY=
# A dónde llegan los mensajes (por defecto, el email de lib/content.ts).
CONTACT_TO_EMAIL=
# Remitente. Mientras no verifiques un dominio propio en Resend, deja el de prueba
# y CONTACT_TO_EMAIL debe ser el mismo email con el que creaste la cuenta de Resend.
CONTACT_FROM_EMAIL=GALEON Web <onboarding@resend.dev>
